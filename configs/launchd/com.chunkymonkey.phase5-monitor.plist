<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  F4 P1: Phase5 GCP retrain monitor (单次 probe), 每 5 min 触发.
  替代 nohup 长轮询 — Mac sleep / shell 退出 / SSH 卡死 proof.

  Probe 行为 (scripts/monitor_phase5_gcp_retrain_probe.sh):
    - 读 data/reports/phase5_chain/model_id.txt
    - gcloud describe VM, RUNNING/PROVISIONING 仅 log + 退出
    - TERMINATED → re-start VM read-only + SSH 拉 smartmoney.duckdb to local.bak + vm_stop
    - 完成后写 monitor_done_<MODEL_ID>.sentinel, 后续 cron silently skip

  Install: bash configs/launchd/install_all.sh install
  原 nohup monitor (scripts/monitor_phase5_gcp_retrain.sh) 保留 backward-compat.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chunkymonkey.phase5-monitor</string>
    <key>Disabled</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/dp/Documents/M/stock/chunkymonkey/scripts/monitor_phase5_gcp_retrain_probe.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/phase5_monitor_probe.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/phase5_monitor_probe.stderr.log</string>
</dict>
</plist>
