<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.chunkymonkey.nightly-data-audit</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/dp/Documents/M/stock/chunkymonkey &amp;&amp; PYTHONPATH=backend /opt/homebrew/opt/python@3.13/libexec/bin/python3 backend/scripts/nightly_data_audit.py --write-default-json --lookback-days 30</string>
