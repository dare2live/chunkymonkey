#!/usr/bin/env bash
# Thin convenience wrapper for backend/scripts/chunkyctl.py.

set -euo pipefail

cd "$(dirname "$0")/.."

# python 解析器 (2026-07-10 根治, 与 safe_commit.sh 同款, mythos PATH 陷阱): 优先项目 venv,
# 回退 python3/python — 裸 `python` 在重启后从 PATH 消失导致 wrapper 全部子命令假死。
if [[ -x ".venv/bin/python3" ]]; then
    PY=".venv/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
else
    PY="python"
fi

usage() {
  cat <<'EOF'
Usage:
  scripts/chunkyctl agent-boot [--format text|json]
  scripts/chunkyctl doctor [--fast] [--skip-storage-payload]
  scripts/chunkyctl sync --domain DOMAIN [--drain] [--max-dates N] [--trigger-mode manual|automatic]
  scripts/chunkyctl sync --domain DOMAIN --backfill --start YYYYMMDD --end YYYYMMDD
  scripts/chunkyctl sync --domain daily|stock_st --start YYYYMMDD --end YYYYMMDD
  scripts/chunkyctl sync --domain daily|stock_st --land-only --start YYYYMMDD --end YYYYMMDD
  scripts/chunkyctl sync --domain daily|stock_st --land-only --from-local-raw --start YYYYMMDD --end YYYYMMDD
  scripts/chunkyctl sync --domain daily|stock_st --accept-from-landing --batch-id BATCH
  scripts/chunkyctl sync --domain daily|stock_st --land-then-accept [--from-local-raw] --start YYYYMMDD --end YYYYMMDD
  scripts/chunkyctl map [--check]
  scripts/chunkyctl derive qfq|form [--from-accepted|--allow-legacy-fill] [--rebuild|--check-only]
  scripts/chunkyctl pipeline acquire|clean|process|store [--force]
  scripts/chunkyctl lineage build | impact <table> | provenance <table> | dead | show <table>

Examples:
  scripts/chunkyctl doctor --fast
  scripts/chunkyctl sync --domain daily --backfill --start 20260715 --end 20260716
  scripts/chunkyctl sync --domain daily --start 20260708 --end 20260717
  scripts/chunkyctl sync --domain daily --land-only --from-local-raw --start 20260115 --end 20260115
  scripts/chunkyctl sync --domain daily --accept-from-landing --batch-id 'daily:20260115:...'
  scripts/chunkyctl derive qfq
  scripts/chunkyctl derive form --rebuild
  scripts/chunkyctl derive qfq --allow-legacy-fill

Notes:
  agent-boot  = one-page session-start context: git + moth summary + codegraph status + generated board; read-only projection.
  doctor      = project health snapshot, including manual-only automation residue enforcement.
  sync        = manual single-domain provider sync through the production runner and writer lock.
                formal daily/stock_st: --start/--end same day or <=40 trading days (no --backfill).
                default --trigger-mode=manual skips same_day_at clock wait on open trading days;
                --trigger-mode=automatic keeps the consumer publication clock (e.g. daily 18:00).
                Calendar weekends/holidays still bind both modes.
                S1 --land-only / S2 --accept-from-landing / thin --land-then-accept are independent
                of the legacy fused fetch→accept path; --from-local-raw materializes landing from
                local raw_tushare_* (never SELECT raw INSERT canonical). Accept path skips provider auth.
  derive      = S5/S7 qfq/form rebuild independent of acquire/accept; default = accepted-only
                nominal (no legacy raw_tushare_daily fill). --allow-legacy-fill = authorized
                pre-accepted UNION escape (pipeline clean/form library also default accepted-only).
                form --rebuild = full rebuild_all; qfq --check-only = sanity without rebuild.
                Not inside accept transaction.
  map         = regenerate FEATURE_MAP.md machine-derived feature map; --check = drift gate only.
  pipeline    = manually run one declared data stage; full manual chain remains daily_update.sh.
  lineage     = generated dependency projection; impact <table> audits fan-in before delete/migrate.
EOF
}

if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

cmd="$1"
shift

# Public commands whose implementations were removed by the platform reset.
# Keep this declaration machine-readable: build_feature_map.py uses it to
# prevent retired surfaces from reappearing as live capabilities.
RETIRED_COMMANDS=(worktree docs preflight audit data-status jobs)
for retired_command in "${RETIRED_COMMANDS[@]}"; do
  if [[ "$cmd" == "$retired_command" ]]; then
    echo "ERROR: chunkyctl command '$cmd' is retired and unavailable." >&2
    exit 2
  fi
done

case "$cmd" in
  agent-boot)
    # One-page boot context (git/moth/codegraph/board); read-only, installs nothing.
    PYTHONPATH=backend "$PY" backend/scripts/agent_boot.py "$@"
    ;;
  doctor)
    args=(doctor)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --fast)
          # `doctor --fast` is the standard startup snapshot; the shared
          # Moth-backed gate already keeps it bounded, so do not skip any
          # required checks here.
          shift
          ;;
        *)
          args+=("$1")
          shift
          ;;
      esac
    done
    PYTHONPATH=backend "$PY" backend/scripts/chunkyctl.py "${args[@]}"
    ;;
  sync)
    # Public manual data boundary: load the same gitignored provider env as the
    # full daily wrapper, then delegate every policy/calendar/lock decision to
    # the production runner.  This command installs no scheduler.
    domain_count=0
    expect_domain_value=0
    for arg in "$@"; do
      if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
        usage
        exit 0
      fi
      if [[ "$arg" == "--all-due" ]]; then
        echo "ERROR: single-domain sync forbids --all-due; use daily_update.sh for the full chain." >&2
        exit 2
      fi
      if [[ $expect_domain_value -eq 1 ]]; then
        if [[ -z "$arg" || "$arg" == --* ]]; then
          echo "ERROR: single-domain sync requires a value after --domain." >&2
          exit 2
        fi
        domain_count=$((domain_count + 1))
        expect_domain_value=0
        continue
      fi
      if [[ "$arg" == "--domain" ]]; then
        expect_domain_value=1
      elif [[ "$arg" == --domain=* ]]; then
        if [[ -z "${arg#--domain=}" ]]; then
          echo "ERROR: single-domain sync requires a non-empty --domain value." >&2
          exit 2
        fi
        domain_count=$((domain_count + 1))
      fi
    done
    if [[ $expect_domain_value -eq 1 || $domain_count -ne 1 ]]; then
      echo "ERROR: single-domain sync requires exactly one --domain DOMAIN." >&2
      exit 2
    fi
    if [[ -f ".env" ]]; then
      set -a; source ".env"; set +a
    fi
    PYTHONPATH=backend "$PY" -m services.data_sources.sync_runner "$@"
    ;;
  derive)
    # S5: qfq/form derive from accepted/canonical — never fused with acquire/accept.
    PYTHONPATH=backend "$PY" backend/scripts/derive_cli.py "$@"
    ;;
  map)
    PYTHONPATH=backend "$PY" backend/scripts/build_feature_map.py "$@"
    ;;
  pipeline)
    # Manual single-stage entrypoint; it never installs or schedules a background job.
    # 全链编排仍用 scripts/daily_update.sh (python -m services.pipeline.run)。
    PYTHONPATH=backend "$PY" -m services.pipeline.stage_runner "$@"
    ;;
  lineage)
    # Generated lineage projection: build | impact <t> | provenance <t> | dead | show <t>
    # 删/迁表前 `chunkyctl lineage impact <table>` 自动 fan-in (替代手 grep)。
    PYTHONPATH=backend "$PY" backend/scripts/lineage_cli.py "$@"
    ;;
  *)
    echo "ERROR: unknown chunkyctl command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
