#!/usr/bin/env bash
# Thin convenience wrapper for backend/scripts/chunkyctl.py.

set -euo pipefail

cd "$(dirname "$0")/.."

usage() {
  cat <<'EOF'
Usage:
  scripts/chunkyctl doctor [--fast] [--skip-storage-payload]
  scripts/chunkyctl worktree [--bucket name] [--format json|markdown]
  scripts/chunkyctl docs [--format json|markdown]
  scripts/chunkyctl jobs [--family job-family] [--backend local] [--job-id id] [--model-id id]
  scripts/chunkyctl preflight "task description" [scope ...] [--agent-dispatch evidence]
  scripts/chunkyctl audit [--run] [scope ...]
  scripts/chunkyctl map [--check]

Examples:
  scripts/chunkyctl doctor --fast
  scripts/chunkyctl worktree
  scripts/chunkyctl worktree --format markdown
  scripts/chunkyctl worktree --bucket updater_split --format markdown
  scripts/chunkyctl docs --format markdown
  scripts/chunkyctl jobs --family model_training --backend local --model-id lgbm_<yyyymmdd> --input-snapshot smartmoney.duckdb@<date> --objective '<why>' --rollback-plan '<stop/discard plan>' --gate-evidence leakage_audit=<artifact> --gate-evidence train_log_integrity=<artifact> --gate-evidence phase4_gate=<artifact>
  scripts/chunkyctl preflight "拆 updater status glue" backend/routers/updater.py backend/tests/test_updater_status.py
  scripts/chunkyctl audit --run backend/scripts/chunkyctl.py backend/tests/scripts/test_chunkyctl.py
  scripts/chunkyctl audit --run --scope backend/scripts/chunkyctl.py --scope backend/tests/scripts/test_chunkyctl.py

Notes:
  doctor     = project health snapshot, including storage payload recursion/size audit unless skipped.
  worktree   = read-only dirty worktree bucket report.
  docs       = docs graph + docs-cleanup worktree-slice readiness.
  jobs       = provider-neutral experiment job contract / plan.
  preflight  = what gates must run before editing a task.
  audit      = scoped post-change checks; add --run to execute them.
  map        = regenerate FEATURE_MAP.md machine-derived feature map; --check = drift gate only.
EOF
}

if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

cmd="$1"
shift

case "$cmd" in
  doctor)
    args=(doctor)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --fast)
          # `doctor --fast` is the standard startup snapshot; the shared
          # Moth-backed gate already keeps it bounded, so do not skip any
          # required checks here.
          shift
          ;;
        *)
          args+=("$1")
          shift
          ;;
      esac
    done
    PYTHONPATH=backend python backend/scripts/chunkyctl.py "${args[@]}"
    ;;
  worktree)
    args=(worktree)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --bucket)
          if [[ $# -lt 2 ]]; then
            echo "ERROR: --bucket requires a name." >&2
            usage >&2
            exit 2
          fi
          args+=(--bucket "$2")
          shift 2
          ;;
        --format)
          if [[ $# -lt 2 ]]; then
            echo "ERROR: --format requires json or markdown." >&2
            usage >&2
            exit 2
          fi
          args+=(--format "$2")
          shift 2
          ;;
        *)
          echo "ERROR: unknown worktree option: $1" >&2
          usage >&2
          exit 2
          ;;
      esac
    done
    PYTHONPATH=backend python backend/scripts/chunkyctl.py "${args[@]}"
    ;;
  docs)
    args=(docs)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --format)
          if [[ $# -lt 2 ]]; then
            echo "ERROR: --format requires json or markdown." >&2
            usage >&2
            exit 2
          fi
          args+=(--format "$2")
          shift 2
          ;;
        *)
          echo "ERROR: unknown docs option: $1" >&2
          usage >&2
          exit 2
          ;;
      esac
    done
    PYTHONPATH=backend python backend/scripts/chunkyctl.py "${args[@]}"
    ;;
  preflight)
    task=""
    args=(preflight)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --task)
          if [[ $# -lt 2 ]]; then
            echo "ERROR: preflight --task requires a description." >&2
            usage >&2
            exit 2
          fi
          task="$2"
          shift 2
          ;;
        --task=*)
          task="${1#--task=}"
          shift
          ;;
        --scope)
          if [[ $# -lt 2 ]]; then
            echo "ERROR: preflight --scope requires a scope." >&2
            usage >&2
            exit 2
          fi
          args+=(--scope "$2")
          shift 2
          ;;
        --scope=*)
          args+=(--scope "${1#--scope=}")
          shift
          ;;
        --agent-dispatch)
          if [[ $# -lt 2 ]]; then
            echo "ERROR: preflight --agent-dispatch requires evidence." >&2
            usage >&2
            exit 2
          fi
          args+=(--agent-dispatch "$2")
          shift 2
          ;;
        --agent-dispatch=*)
          args+=(--agent-dispatch "${1#--agent-dispatch=}")
          shift
          ;;
        --agent-skip-reason)
          if [[ $# -lt 2 ]]; then
            echo "ERROR: preflight --agent-skip-reason requires a reason." >&2
            usage >&2
            exit 2
          fi
          args+=(--agent-skip-reason "$2")
          shift 2
          ;;
        --agent-skip-reason=*)
          args+=(--agent-skip-reason "${1#--agent-skip-reason=}")
          shift
          ;;
        --*)
          echo "ERROR: unknown preflight option: $1" >&2
          usage >&2
          exit 2
          ;;
        *)
          if [[ -z "$task" ]]; then
            task="$1"
          else
            args+=(--scope "$1")
          fi
          shift
          ;;
      esac
    done
    if [[ -z "$task" ]]; then
      echo "ERROR: preflight requires a task description." >&2
      usage >&2
      exit 2
    fi
    args+=(--task "$task")
    PYTHONPATH=backend python backend/scripts/chunkyctl.py "${args[@]}"
    ;;
  audit)
    args=(audit)
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --run|--include-stdout)
          args+=("$1")
          shift
          ;;
        --scope)
          if [[ $# -lt 2 ]]; then
            echo "ERROR: audit --scope requires a path." >&2
            usage >&2
            exit 2
          fi
          args+=(--scope "$2")
          shift 2
          ;;
        *)
          args+=(--scope "$1")
          shift
          ;;
      esac
    done
    PYTHONPATH=backend python backend/scripts/chunkyctl.py "${args[@]}"
    ;;
  jobs)
    PYTHONPATH=backend python backend/scripts/chunkyctl.py jobs "$@"
    ;;
  map)
    PYTHONPATH=backend python backend/scripts/build_feature_map.py "$@"
    ;;
  *)
    echo "ERROR: unknown chunkyctl command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
